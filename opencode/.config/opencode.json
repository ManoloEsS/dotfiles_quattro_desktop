{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "grep *": "allow",
      "curl *": "allow",
      "git status *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "which *": "allow",
      "pwd": "allow",
      "wc *": "allow"
    },
    "external_directory": {
      "~/**": "allow"
    }
  }
}